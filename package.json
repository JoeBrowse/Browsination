    "@capacitor/share": "8.0.2",
    "lucide-react": "1.47.0",
    "pdfjs-dist": "^6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "sql.js": "1.14.2",
    "zustand": "5.0.15"
  },
  "devDependencies": {
